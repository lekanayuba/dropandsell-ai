# Database
DATABASE_URL=postgresql://user:password@localhost:5432/dropandsell

# Session secret (generate a random string)
SESSION_SECRET=change-me-to-a-random-string

# Optional Replit OIDC auth (required only when using /api/login)
ISSUER_URL=https://replit.com/oidc
REPL_ID=

# Stripe keys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Resend (email)
RESEND_API_KEY=re_...

# OpenAI (support chat)
OPENAI_API_KEY=sk-...

# App URL (used for links in emails)
APP_URL=http://localhost:5000

# eBay API (for auto-syncing delivery status + ending OOS listings)
# Get these at https://developer.ebay.com/
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_RU_NAME=

# Amazon SP-API (for listing, stock, and pricing sync)
# Get these at https://developer.amazonservices.com/
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=

# Shopify REST API (for listing and order sync)
# Generate at your Shopify store Admin > Apps > Admin API
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_STORE_DOMAIN=

# Jumia Open API (for listing and order sync)
# Get these from your Jumia seller account
JUMIA_API_KEY=
JUMIA_API_SECRET=
JUMIA_SELLER_ID=

# WooCommerce REST API (for listing and order sync)
# Generate at your WooCommerce store Admin > WooCommerce > Settings > Advanced > REST API
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_STORE_URL=

# Tracking API (for automatic delivery detection, optional)
# Free tier at https://www.17track.net/en
TRACKING_API_KEY=
